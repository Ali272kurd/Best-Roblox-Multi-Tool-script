-- Animation Loop (Wavy Red/Black Shader flow, stuck tightly at 99%)
task.spawn(function()
    local startTime = tick()
    local statuses = {
        "Decrypting core assets...",
        "Injecting visual framework...",
        "Hooking game remotes...",
        "Bypassing client integrity checks...",
        "Synchronizing script state..."
    }
    
    while true do
        local elapsed = tick() - startTime
        
        -- Fluid wave shifting for the red/black rainbow gradients
        local waveOffset = math.sin(elapsed * 2.5) * 0.45 + 0.5
        UIGradient.Offset = Vector2.new(waveOffset, 0)
        FillGradient.Offset = Vector2.new(math.sin(elapsed * 4) * 0.5, 0)
        
        -- Pulse the ambient background glow
        AmbientGlow.BackgroundTransparency = 0.8 + math.sin(elapsed * 3) * 0.08
        
        -- Asymptotic formula: climbs smoothly, then anchors heavily at 99% forever
        local progress = 99 * (1 - math.exp(-elapsed / 3.5))
        if progress > 98.95 then
            progress = 99
            StatusLabel.Text = "Waiting for server synchronization..."
            SubText.TextColor3 = Color3.fromRGB(180, 0, 0)
        else
            local idx = math.clamp(math.floor((progress / 99) * #statuses) + 1, 1, #statuses)
            StatusLabel.Text = statuses[idx]
        end
        
        BarFill.Size = UDim2.new(progress / 100, 0, 1, 0)
        PercentLabel.Text = math.format and string.format("%.1f%%", progress) or (math.floor(progress) .. "%")
        
        RunService.RenderStepped:Wait()
    end
end)
