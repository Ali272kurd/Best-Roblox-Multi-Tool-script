local loops = {}
local function summarize(res)
if typeof(res) ~= "table" then return tostring(res) end
local p = {}
for k, v in pairs(res) do p[#p + 1] = tostring(k) .. "=" .. tostring(v) end
local s = table.concat(p, ", ")
return #s > 90 and s:sub(1, 90) .. "..." or s
