CMDBar.FocusLost:Connect(function(enterPressed)
	if enterPressed and CMDBar.Text ~= "" then
		local text = CMDBar.Text
		if text:sub(1,1) == "/" then
			text = text:sub(2)
		end
		local args = {}
		for word in text:gmatch("%S+") do
			table.insert(args, word)
		end
		local cmd = args[1] and args[1]:lower()
		if cmd == "tp" then
			local target = GetPlayer(args[2])
			if target then TeleportTO(0,0,0, target, "normal") end
		elseif cmd == "speed" and args[2] then
			pcall(function() plr.Character.Humanoid.WalkSpeed = tonumber(args[2]) end)
		elseif cmd == "jump" and args[2] then
			pcall(function() plr.Character.Humanoid.JumpPower = tonumber(args[2]) end)
		end
		CMDBar.Text = ""
	end
