                ScriptConfig.Whitelist[targetP.UserId] = not currentStatus
                ScriptConfig.Whitelist[targetP.Name] = not currentStatus
            end
        end
    end
    pcall(function()
        Options.PlayerSelectDropdown:SetValues(getPlayerListValues())
    end)
end)

