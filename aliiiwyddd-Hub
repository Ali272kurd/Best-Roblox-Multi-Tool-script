local function getPlayerListValues()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local dist = 0
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                dist = math.floor((player.Character.HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude)
            end
            local statusTag = ScriptConfig.SelectedPlayers[p.Name] and " [SELECTED ✓]" or ""
            local wlTag = ScriptConfig.Whitelist[p.UserId] and " [WL]" or ""
            table.insert(list, p.DisplayName .. " (@" .. p.Name .. ")" .. statusTag .. wlTag .. " - " .. dist .. "m")
        end
    end
    if #list == 0 then table.insert(list, "None") end
    return list
end

