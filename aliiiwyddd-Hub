-- Raycast setup for Wall Checks
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
raycastParams.IgnoreWater = true

local function WallCheck(part)
    if not ScriptConfig.TriggerBot.WallCheck then return true end
    local character = player.Character
    if not character then return false end
    
    raycastParams.FilterDescendantsInstances = {character}
    local origin = playerCamera.CFrame.Position
    local direction = part.Position - origin
    
    local result = Workspace:Raycast(origin, direction, raycastParams)
    if result and result.Instance:IsDescendantOf(part.Parent) then
        return true
    end
    return false
end

-- Knife/Weapon Check
local function IsValidWeapon(tool)
    if not ScriptConfig.TriggerBot.KnifeCheck then return true end
    if not tool then return false end
    local name = string.lower(tool.Name)
    if string.find(name, "knife") or string.find(name, "sword") or string.find(name, "melee") or string.find(name, "bat") or string.find(name, "fist") then
        return false
    end
    return true
end

-- ForceField Check
local function HasForceField(targetChar)
    if not ScriptConfig.TriggerBot.ForceFieldCheck then return false end
    return targetChar:FindFirstChildOfClass("ForceField") ~= nil
end

-- Whitelist Check
local function IsWhitelisted(targetPlayer)
    if not targetPlayer then return false end
    return ScriptConfig.Whitelist[targetPlayer.UserId] == true or ScriptConfig.SelectedPlayers[targetPlayer.Name] == true
end

-- Get Current FOV Center Position
local function GetFOVCenter()
    if ScriptConfig.FOV.FollowMode == "Mouse / Touch" then
        local mousePos = UserInputService:GetMouseLocation()
        return Vector2.new(mousePos.X, mousePos.Y)
    else
        local center = Vector2.new(playerCamera.ViewportSize.X / 2, playerCamera.ViewportSize.Y / 2)
        return Vector2.new(center.X + ScriptConfig.FOV.OffsetX, center.Y + ScriptConfig.FOV.OffsetY)
    end
end

-- Get Closest Target inside FOV scanning all valid body parts
local function GetClosestTarget()
    local localChar = player.Character
    if not localChar then return nil end
    local localHum = localChar:FindFirstChildOfClass("Humanoid")
    if not localHum or localHum.Health <= 0 then return nil end

    local closestTarget = nil
    local shortestDistance = math.huge
    local fovCenter = GetFOVCenter()

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and not IsWhitelisted(p) then
            local char = p.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                if not HasForceField(char) then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            local vpPos, onScreen = playerCamera:WorldToViewportPoint(part.Position)
                            if onScreen then
                                local dist = (Vector2.new(vpPos.X, vpPos.Y) - fovCenter).Magnitude
                                if dist <= ScriptConfig.FOV.Radius and dist < shortestDistance then
                                    if WallCheck(part) then
                                        closestTarget = char
                                        shortestDistance = dist
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return closestTarget
end

-- Storage for ESP Drawing objects per player
local espCache = {}

local function removeESP(p)
    if espCache[p] then
        for _, obj in pairs(espCache[p]) do
            pcall(function() obj:Remove() end)
        end
        espCache[p] = nil
    end
end

-- Dynamic Chams Applier
local function applyChamsToCharacter(char, apply)
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if apply and ScriptConfig.Chams.Enabled then
                local targetType = ScriptConfig.Chams.TargetType
                local isSelf = (char == player.Character)
                
                local shouldApply = false
                if targetType == "All Players" then
                    shouldApply = true
                elseif targetType == "Enemies Only" and not isSelf then
                    shouldApply = true
                elseif targetType == "Myself Only" and isSelf then
                    shouldApply = true
                end

                if shouldApply then
                    pcall(function()
                        part.Material = Enum.Material[ScriptConfig.Chams.MaterialMode] or Enum.Material.ForceField
                        part.Color = ScriptConfig.Chams.Color
                    end)
                else
                    part.Material = Enum.Material.Plastic
                end
            else
                part.Material = Enum.Material.Plastic
            end
        end
    end
end

-- Main RenderStepped Loop
RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = ScriptConfig.FOV.Visible
    FOVCircle.Radius = ScriptConfig.FOV.Radius
    FOVCircle.Color = ScriptConfig.FOV.Color
    FOVCircle.Transparency = ScriptConfig.FOV.Transparency
    FOVCircle.Thickness = ScriptConfig.FOV.Thickness
    FOVCircle.Position = GetFOVCenter()

    -- Character Speed, Jump, and Spinbot Modifiers
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum then
            if ScriptConfig.Character.SpeedEnabled then
                hum.WalkSpeed = ScriptConfig.Character.WalkSpeed
            end
            if ScriptConfig.Character.JumpEnabled then
                hum.JumpPower = ScriptConfig.Character.JumpPower
            end
        end
        if root and ScriptConfig.Character.SpinEnabled then
            root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(ScriptConfig.Character.SpinSpeed), 0)
        end
    end

    -- Triggerbot Execution
    if ScriptConfig.TriggerBot.Enabled then
        local target = GetClosestTarget()
        if target then
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool and IsValidWeapon(tool) then
                local triggered = false
                for _, part in ipairs(target:GetDescendants()) do
                    if part:IsA("BasePart") then
                        local vpPos, onScreen = playerCamera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dist = (Vector2.new(vpPos.X, vpPos.Y) - FOVCircle.Position).Magnitude
                            if dist <= ScriptConfig.FOV.Radius then
                                triggered = true
                                break
                            end
                        end
                    end
                end

                if triggered then
                    if ScriptConfig.TriggerBot.ClickDelay > 0 then
                        task.wait(ScriptConfig.TriggerBot.ClickDelay)
                    end
                    pcall(function() tool:Activate() end)
                end
            end
        end
    end

    -- View Mode Handling
    if ScriptConfig.IsViewing and ScriptConfig.TargetViewPlayer then
        local targetP = Players:FindFirstChild(ScriptConfig.TargetViewPlayer)
        if targetP and targetP.Character and targetP.Character:FindFirstChild("Humanoid") then
            playerCamera.CameraSubject = targetP.Character.Humanoid
        end
    else
        if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
            playerCamera.CameraSubject = player.Character:FindFirstChildOfClass("Humanoid")
        end
    end

    -- Fling Logic
    if ScriptConfig.IsFlinging and ScriptConfig.TargetFlingPlayer then
        local targetP = Players:FindFirstChild(ScriptConfig.TargetFlingPlayer)
        if targetP and targetP.Character and targetP.Character:FindFirstChild("HumanoidRootPart") then
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local tRoot = targetP.Character.HumanoidRootPart
            if root then
                root.AssemblyLinearVelocity = Vector3.new(30000, 30000, 30000)
                root.CFrame = tRoot.CFrame
            end
        end
    end

    -- ESP & Chams Rendering Update Loop
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local pChar = p.Character
            local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")
            local rootPart = pChar and pChar:FindFirstChild("HumanoidRootPart")

            if pChar and pHum and pHum.Health > 0 and rootPart then
                if not espCache[p] then
                    espCache[p] = {
                        Box = Drawing.new("Square"),
                        Name = Drawing.new("Text"),
                        Tracer = Drawing.new("Line"),
                        Health = Drawing.new("Text")
                    }
                    espCache[p].Box.Filled = false
                    espCache[p].Box.Thickness = 1.5
                    espCache[p].Name.Size = 14
                    espCache[p].Name.Center = true
                    espCache[p].Name.Outline = true
                    espCache[p].Health.Size = 13
                    espCache[p].Health.Center = true
                    espCache[p].Health.Outline = true
                    espCache[p].Tracer.Thickness = 1.5
                end

                local cache = espCache[p]
                local vector, onScreen = playerCamera:WorldToViewportPoint(rootPart.Position)

                if onScreen then
                    local head = pChar:FindFirstChild("Head")
                    local headPos = head and playerCamera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vector
                    local legPos = playerCamera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height / 2

                    if ScriptConfig.ESP.Boxes then
                        cache.Box.Visible = true
                        cache.Box.Size = Vector2.new(width, height)
                        cache.Box.Position = Vector2.new(vector.X - width / 2, headPos.Y)
                        cache.Box.Color = Color3.fromRGB(255, 255, 0)
                    else
                        cache.Box.Visible = false
                    end

                    if ScriptConfig.ESP.Names then
                        cache.Name.Visible = true
                        cache.Name.Text = p.DisplayName .. " (@" .. p.Name .. ")"
                        cache.Name.Position = Vector2.new(vector.X, headPos.Y - 18)
                        cache.Name.Color = Color3.fromRGB(255, 255, 255)
                    else
                        cache.Name.Visible = false
                    end

                    if ScriptConfig.ESP.Health then
                        cache.Health.Visible = true
                        cache.Health.Text = "HP: " .. math.floor(pHum.Health)
                        cache.Health.Position = Vector2.new(vector.X - width/2 - 30, headPos.Y)
                        cache.Health.Color = Color3.fromRGB(0, 255, 0)
                    else
                        cache.Health.Visible = false
                    end

                    if ScriptConfig.ESP.Tracers then
                        cache.Tracer.Visible = true
                        cache.Tracer.From = Vector2.new(playerCamera.ViewportSize.X / 2, playerCamera.ViewportSize.Y)
                        cache.Tracer.To = Vector2.new(vector.X, legPos.Y)
                        cache.Tracer.Color = Color3.fromRGB(255, 255, 0)
                    else
                        cache.Tracer.Visible = false
                    end
                else
                    cache.Box.Visible = false
                    cache.Name.Visible = false
                    cache.Health.Visible = false
                    cache.Tracer.Visible = false
                end

                applyChamsToCharacter(pChar, true)
            else
                removeESP(p)
            end
        end
    end

    if player.Character then
        applyChamsToCharacter(player.Character, true)
    end
end)

