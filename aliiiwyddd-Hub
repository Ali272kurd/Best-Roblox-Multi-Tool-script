LeftCharGroup:AddToggle("SpeedToggle", {
    Text = "Enable Custom WalkSpeed",
    Default = false,
    Callback = function(value) ScriptConfig.Character.SpeedEnabled = value end
})

LeftCharGroup:AddSlider("WalkSpeedSlider", {
    Text = "WalkSpeed Value",
    Default = 16,
    Min = 16,
    Max = 150,
    Rounding = 0,
    Callback = function(value) ScriptConfig.Character.WalkSpeed = value end
})

LeftCharGroup:AddToggle("JumpToggle", {
    Text = "Enable Custom JumpPower",
    Default = false,
    Callback = function(value) ScriptConfig.Character.JumpEnabled = value end
})

LeftCharGroup:AddSlider("JumpPowerSlider", {
    Text = "JumpPowerValue",
    Default = 50,
    Min = 50,
    Max = 300,
    Rounding = 0,
    Callback = function(value) ScriptConfig.Character.JumpPower = value end
})

LeftCharGroup:AddToggle("SpinbotToggle", {
    Text = "Enable Spinbot",
    Default = false,
    Callback = function(value) ScriptConfig.Character.SpinEnabled = value end
})

LeftCharGroup:AddSlider("SpinSpeedSlider", {
    Text = "Spin Speed",
    Default = 20,
    Min = 5,
    Max = 100,
    Rounding = 0,
    Callback = function(value) ScriptConfig.Character.SpinSpeed = value end
})

-- Config Tab Integration
local ConfigGroup = Tabs.Config:AddLeftGroupbox("Configuration Manager", "settings")

ConfigGroup:AddButton("Unload Hub", function()
    ScreenGui:Destroy()
    FOVCircle:Remove()
    Library:Unload()
end)

pcall(function()
    ShowRealRobloxNotification("aliiiwyddd-Hub", "Hub successfully loaded!")
end)
