-- Real Roblox Native Notification System (Strictly Debounced)
local lastNotificationText = ""
local lastNotificationTick = 0

local function ShowRealRobloxNotification(title, text)
    local currentTime = tick()
    if text == lastNotificationText and (currentTime - lastNotificationTick) < 1.2 then
        return
    end
    lastNotificationText = text
    lastNotificationTick = currentTime

    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Icon = ScriptConfig.TriggerBot.ButtonDecalID,
            Duration = 3.5
        })
    end)
end

local function ToggleTriggerBotState(newState)
    if ScriptConfig.TriggerBot.Enabled == newState then return end
    ScriptConfig.TriggerBot.Enabled = newState
    if Toggles.TBEnabled and Toggles.TBEnabled.Value ~= newState then
        Toggles.TBEnabled:SetValue(newState)
    end
    if newState then
        UIStroke.Color = Color3.fromRGB(0, 255, 128)
        ShowRealRobloxNotification("Triggerbot", "Triggerbot Enabled")
    else
        UIStroke.Color = Color3.fromRGB(255, 50, 50)
        ShowRealRobloxNotification("Triggerbot", "Triggerbot Disabled")
    end
end

